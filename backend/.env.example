# Server Configuration
PORT=3055
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Razorpay Credentials (Required for payments)
# Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Razorpay Webhook (Required for reliable payment recording)
# Dashboard -> Settings -> Webhooks. Generate with: openssl rand -hex 32
# Paste the SAME value here and into the webhook config in the dashboard.
# Test Mode and Live Mode have separate webhooks and separate secrets.
RAZORPAY_WEBHOOK_SECRET=

# Supabase (Required - the backend writes donations with the service role)
# Dashboard -> Project Settings -> API
# WARNING: the service role key bypasses ALL row level security.
# Never expose it to the frontend, never prefix it VITE_, never log it.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Nodemailer / SMTP Email (Required for email reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Twilio SMS (Optional - logs mock SMS to console if empty)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
