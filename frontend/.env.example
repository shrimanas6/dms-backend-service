# Supabase Cloud Database & Auth (Required)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Express Backend URL (Optional, defaults to http://127.0.0.1:3055)
VITE_API_URL=http://127.0.0.1:3055

# NOTE: VITE_RAZORPAY_KEY_ID is intentionally absent. The publishable key now
# comes back from POST /api/payments/order, so there is no way for the frontend
# and backend to drift between test and live keys.
